# Скопируйте в .env и заполните
JWT_SECRET=сгенерируйте-длинную-случайную-строку
DEV_MODE=false

# Google OAuth (Module 1.3). Пока пусто — работает dev-режим входа
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_EMAILS=admin@lab.test

# Модуль 2 (значения подставляются в сборку PWA)
PWA_API_URL=http://localhost:8000/api/v1
PWA_CODEGEN_URL=http://localhost:8001

# Telegram (понадобится для Модуля 3)
BOT_TOKEN=
INTERNAL_API_SECRET=сгенерируйте-длинную-случайную-строку

TELEGRAM_BOT_WEBHOOK_URL=http://telegram-bot:8080/bot/webhook
PWA_PUBLIC_URL=https://lab.example.ru
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SEED_ADMIN_EMAIL=admin@lab.test

# Модуль 4: генератор кодов и печать
PRINTER_MODEL=QL-800
# Не заполняйте, пока принтер не куплен. Примеры:
#   сеть:  PRINTER_ADDRESS=tcp://192.168.1.100:9100
#   USB:   PRINTER_ADDRESS=usb://0x04f9:0x209e
PRINTER_ADDRESS=
LABEL_SIZE=62x100
PRINTER_DRY_RUN=false